# DATABASE & PRISMA CONFIGURATION
DATABASE_URL="postgresql://postgres:password@localhost:5432/kreasi_ai_studio?schema=public"

# AUTHENTICATION (Auth.js / NextAuth / JWT)
AUTH_SECRET="your-super-secret-auth-key-generate-via-openssl-rand-hex-32"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# MIDTRANS PAYMENT GATEWAY (SNAP & WEBHOOK)
# Dapatkan di Midtrans Merchant Portal (Settings -> Access Keys)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID="Gxxxxxxxxx"

# AI PROVIDERS
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"
AI_PROVIDER_API_KEY="sk-your-ai-provider-api-key"

# S3-COMPATIBLE OBJECT STORAGE (Cloudflare R2 / AWS S3 / MinIO)
OBJECT_STORAGE_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
OBJECT_STORAGE_BUCKET="kreasi-ai-studio-assets"
OBJECT_STORAGE_ACCESS_KEY="your-access-key-id"
OBJECT_STORAGE_SECRET_KEY="your-secret-access-key"
OBJECT_STORAGE_PUBLIC_URL="https://assets.kreasi.id"

# APPLICATION CONFIGURATION
APP_URL="http://localhost:3000"
APP_NAME="KREASI AI STUDIO"
ADMIN_BOOTSTRAP_SECRET="admin-secret-setup-token"
